# ──────────────────────────────────────────────────────────────────────────────
# CallGuard – Server Environment
# Loaded by the Express server at startup (server/src/config.js).
# Copy this file to server/.env and fill in your real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── Twilio ────────────────────────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Google Calendar ───────────────────────────────────────────────────────────
# Service-account credentials from Google Cloud Console
# See: https://cloud.google.com/iam/docs/service-accounts-create
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used by the Ava dialogue engine (optional – Ava works without it via regex)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=https://your-domain.ngrok.io

# ── Owner Alerts ──────────────────────────────────────────────────────────────
# Phone number that receives missed-call and new-job SMS alerts
OWNER_PHONE=+1XXXXXXXXXX

# ── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development
