{
  "name": "callguard-server",
  "version": "1.0.0",
  "description": "CallGuard AI receptionist backend – Twilio voice, booking, dashboard",
  "main": "src/index.js",
  "scripts": {
    "start": "node -r ts-node/register src/index.js",
    "dev": "node --watch -r ts-node/register src/index.js",
    "build:dashboard": "node scripts/build-dashboard.js",
    "test": "node -r ts-node/register ./node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "keywords": [
    "twilio",
    "voice",
    "ai-receptionist",
    "booking"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/standalone": "^7.29.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "fuse.js": "^7.1.0",
    "googleapis": "^144.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "jsonwebtoken": "^9.0.2",
    "twilio": "^5.4.3",
    "uuid": "^13.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": ">=5.0.5"
  }
}
