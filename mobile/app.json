{
  "expo": {
    "name": "CallGuard",
    "slug": "callguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030508"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.callguard.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "CallGuard may need camera access for future features.",
        "NSMicrophoneUsageDescription": "CallGuard needs microphone access for live call takeover."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030508"
      },
      "package": "com.callguard.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00C2FF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
