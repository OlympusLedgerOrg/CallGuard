# ──────────────────────────────────────────────────────────────────────────────
# CallGuard – Root Environment
# This file is loaded by Prisma for database migrations and client generation.
# Server-specific variables (Twilio, Google, OpenAI, etc.) go in server/.env
# ──────────────────────────────────────────────────────────────────────────────

# SQLite database (file-based, no external DB server needed)
# The default path is data/callguard.db — no config needed for local dev.
# DATABASE_URL="file:./data/callguard.db"

# To switch to PostgreSQL:
#   1. Change `provider` in prisma/schema.prisma from "sqlite" to "postgresql"
#   2. Uncomment and set the URL below, then run: prisma migrate deploy
# DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:5432/callguard?schema=public"

# ── Production (docker-compose.prod.yml) ──────────────────────────────────────
# Domain name for automatic HTTPS via Caddy (Let's Encrypt)
# DOMAIN=callguard.example.com
