# ──────────────────────────────────────────────────────────────────────────────
# CallGuard – Root Environment
# This file is loaded by Prisma for database migrations and client generation.
# Server-specific variables (Twilio, Google, OpenAI, etc.) go in server/.env
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/callguard?schema=public"

# Node environment (development | production | test)
NODE_ENV="development"
