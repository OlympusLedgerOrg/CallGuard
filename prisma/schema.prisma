// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  // To switch to PostgreSQL:
  //   1. Change provider above to "postgresql"
  //   2. Set DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"
  //      in your .env (root) or via the DATABASE_URL environment variable.
  //   3. Run: prisma migrate deploy
}

// ─── Businesses ──────────────────────────────────────────────────────────────
// Stores each business owner's account and configuration.
model Business {
  id                  String    @id @default(uuid())
  name                String
  ownerName           String    @map("owner_name")
  email               String    @unique
  phone               String?
  serviceArea         String    @default("[]") @map("service_area")
  serviceCategories   String    @default("[]") @map("service_categories")
  hoursOfOperation    String?   @map("hours_of_operation")
  emergencyRate       Int?      @map("emergency_rate")
  emergencyHours      String?   @map("emergency_hours")
  systemPrompt        String?   @map("system_prompt")
  voice               String    @default("alloy")
  timezone            String    @default("America/New_York")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  twilioNumbers TwilioNumber[]
  calls         Call[]
  appointments  Appointment[]
  oauthTokens   OauthToken[]
  smsLogs       SmsLog[]
  jobRequests   JobRequest[]
  callbackRequests CallbackRequest[]

  @@map("businesses")
}

// ─── Twilio Numbers ───────────────────────────────────────────────────────────
// Links Twilio phone numbers to businesses.
model TwilioNumber {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  phoneNumber String   @unique @map("phone_number")
  sid         String   @unique
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("twilio_numbers")
}

// ─── Calls ────────────────────────────────────────────────────────────────────
// One row per inbound call.
model Call {
  id             String   @id @default(uuid())
  businessId     String   @map("business_id")
  twilioCallSid  String   @unique @map("twilio_call_sid")
  callerNumber   String   @map("caller_number")
  callerName     String?  @map("caller_name")
  zipCode        String?  @map("zip_code")
  serviceType    String?  @map("service_type")
  urgency        String?
  outcome        String?
  appointmentId  String?  @map("appointment_id")
  durationSeconds Int?    @map("duration_seconds")
  createdAt      DateTime @default(now()) @map("created_at")

  disposition     String?
  aiHandled       Boolean  @default(false) @map("ai_handled")
  jobRequestId    String?  @map("job_request_id")

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transcript  Transcript?
  appointment Appointment? @relation("CallAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  smsLogs     SmsLog[]

  @@index([businessId])
  @@index([createdAt])
  @@map("calls")
}

// ─── Transcripts ──────────────────────────────────────────────────────────────
// Stores the conversation transcript. Separated from calls because transcripts
// can be large and may be offloaded to blob storage later.
model Transcript {
  id        String   @id @default(uuid())
  callId    String   @unique @map("call_id")
  rawText   String?  @map("raw_text")
  segments  String?
  createdAt DateTime @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("transcripts")
}

// ─── Appointments ─────────────────────────────────────────────────────────────
// Represents booked appointments (syncs with Google Calendar event ID).
model Appointment {
  id             String    @id @default(uuid())
  businessId     String    @map("business_id")
  callId         String?   @map("call_id")
  googleEventId  String?   @map("google_event_id")
  customerName   String    @map("customer_name")
  customerPhone  String    @map("customer_phone")
  serviceType    String    @map("service_type")
  scheduledFor   DateTime  @map("scheduled_for")
  notes          String?
  status         String    @default("confirmed")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  callLink Call[]   @relation("CallAppointment")

  @@index([businessId])
  @@index([scheduledFor])
  @@map("appointments")
}

// ─── OAuth Tokens ─────────────────────────────────────────────────────────────
// Stores Google OAuth tokens for calendar access (encrypted in production).
model OauthToken {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  provider     String
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiry       DateTime?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@map("oauth_tokens")
}

// ─── SMS Logs ─────────────────────────────────────────────────────────────────
// Records SMS notifications sent to business owners.
model SmsLog {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  callId     String?  @map("call_id")
  recipient  String
  body       String?
  status     String?
  twilioSid  String?  @map("twilio_sid")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call     Call?    @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@map("sms_logs")
}

// ─── Job Requests ─────────────────────────────────────────────────────────────
// Tracks job/service requests created by Ava from inbound calls.
model JobRequest {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  callId       String?  @map("call_id")
  issue        String?
  address      String?
  urgency      String   @default("normal")
  disposition  String   @default("lead")
  status       String   @default("new")
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@map("job_requests")
}

// ─── Callback Requests ────────────────────────────────────────────────────────
// Call Me Back queue — captures unresolved calls so the owner can tap-to-callback.
model CallbackRequest {
  id             String    @id @default(uuid())
  businessId     String    @map("business_id")
  callId         String?   @map("call_id")
  callerName     String?   @map("caller_name")
  callerPhone    String    @map("caller_phone")
  reason         String?
  urgency        String    @default("normal")
  status         String    @default("pending")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@map("callback_requests")
}
